{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar Sistema Academico",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-Wall",
        "-Wextra",
        "-g3",
        "src/main.c",
        "src/aluno.c",
        "src/materia.c",
        "src/historico.c",
        "src/util.c",
        "src/conexao.c",
        "-o",
        "src/output/main.exe",
        "-lodbc32"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Compila todos os arquivos do sistema"
    }
  ]
}